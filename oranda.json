{
    "build": {
      "path_prefix": "glasswing-power"
    },
    "project": {
        "repository": "https://github.com/pain459/glasswing-power"    
    },
    "styles": {
      "theme": "light",
      "favicon": "docs_src/favicon.ico"
    },
    "marketing": {
      "social": {
        "image": "https://raw.githubusercontent.com/pain459/glasswing-power/main/docs_src/scaphandre.cleaned.png",
        "image_alt": "Glasswing Power",
        "twitter_account": "@pain459"
      }
    },
    "components": {
      "changelog": true,
      "artifacts": {
          "auto": true,
          "cargo_dist": false,
          "package_managers": {
            "preferred": {
              "crates.io": "cargo install glasswing-power",
              "DEB package": "dpkg -i glasswing-power.X.deb",
              "docker": "docker pull pain459/glasswing-power",
              "RPM package": "rpm -ivh glasswing-power.X.rpm"
            }
          }
      },
      "funding": {
          "preferred_funding": "github"
      }
    }
}
